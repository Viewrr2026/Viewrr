# Viewrr Mobile — local environment template.
# Copy to `.env` (git-ignored). Nothing secret belongs in this file:
# anything prefixed EXPO_PUBLIC_ is embedded in the JS bundle and readable
# by anyone with the app.

# Which environment app.config.ts should build for.
# development | staging | production
APP_ENV=development

# Optional override for the API base URL (development/staging only).
# Must be ABSOLUTE. Use your machine's LAN IP for physical-device testing —
# localhost resolves to the device itself, not your Mac.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:5000

# ── Expo / EAS linkage ────────────────────────────────────────────────────────
# These bind the local app to the EXISTING Expo dashboard project.
# Fill in from the Expo dashboard before running any EAS command.
# Leaving them empty is safe: app.config.ts omits owner/projectId entirely
# rather than inventing values.
# EXPO_SLUG=
# EXPO_OWNER=
# EAS_PROJECT_ID=
