{
  "name": "viewrr-mobile",
  "main": "expo-router/entry",
  "version": "0.1.1",
  "description": "Viewrr mobile app (React Native + Expo). Isolated package \u2014 not part of the root web/server build.",
  "dependencies": {
    "@stripe/stripe-react-native": "0.64.0",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.2",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "lucide-react-native": "^1.37.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:staging": "APP_ENV=staging expo start",
    "start:production": "APP_ENV=production expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "release:config": "node scripts/check-release.mjs",
    "release:preflight": "npm run fonts:check && npm run release:config && npm run test:dependencies && npm run typecheck && expo install --check",
    "doctor": "npx expo-doctor",
    "lint": "expo lint",
    "postinstall": "node scripts/patch-query-string.cjs && node scripts/prepare-fonts.mjs",
    "test:dependencies": "node --test scripts/dependency-security.test.cjs",
    "fonts:prepare": "node scripts/prepare-fonts.mjs",
    "fonts:check": "node scripts/prepare-fonts.mjs --check"
  },
  "private": true,
  "overrides": {
    "shell-quote": "1.11.0",
    "brace-expansion": "5.0.12",
    "decode-uri-component": "0.5.0",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
